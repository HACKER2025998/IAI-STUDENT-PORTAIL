<Project Sdk="Microsoft.NET.Sdk">
  <!-- Un exécutable de tests autonome évite de dépendre d'un service externe. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowMissingPrunePackageData>true</AllowMissingPrunePackageData></PropertyGroup>
  <!-- Les tests utilisent les vrais services du backend et non une copie des calculs. -->
  <ItemGroup><ProjectReference Include="../../backend/backend.csproj"/></ItemGroup>
</Project>
