# Copiez ce fichier en .env et remplacez les valeurs avant Docker Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# Le premier administrateur est créé uniquement si aucun administrateur n'existe.
ADMIN_USERNAME=admin
# Le secret doit contenir au moins douze caractères et ne doit pas être commité.
ADMIN_PASSWORD=replace-with-a-different-long-random-secret
# Générer un secret Base32 personnel et le configurer dans une application TOTP.
ADMIN_MFA_SECRET=REPLACE_WITH_32_BASE32_CHARACTERS
